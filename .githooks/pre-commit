#!/bin/sh
# Pre-commit: secret scan (gitleaks) and lint (ruff). Enabled by: git config core.hooksPath .githooks
set -eu
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks absent : brew install gitleaks" >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --no-banner
uv run --locked ruff check .
