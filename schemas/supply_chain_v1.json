{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "material", "routes", "nodes", "edges", "substitutes",
    "structural_risks", "upcoming_dates", "open_questions", "injection_suspected"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "cas", "hs_code_candidates"],
      "properties": {
        "name": {"type": "string"},
        "cas": {"type": "string", "description": "Numéro CAS reçu dans <material>, recopié sans modification."},
        "hs_code_candidates": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Codes SH à 6 chiffres plausibles, à vérifier."
        }
      }
    },
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}, "minItems": 1},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "substitutes": {"type": "array", "items": {"$ref": "#/$defs/substitute"}},
    "structural_risks": {"type": "array", "items": {"$ref": "#/$defs/structural_risk"}},
    "upcoming_dates": {"type": "array", "items": {"$ref": "#/$defs/upcoming_date"}},
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "injection_suspected": {"type": "boolean"}
  },
  "$defs": {
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "name", "global_share_pct", "description", "node_ids", "source_ids"],
      "properties": {
        "route_id": {"type": "string"},
        "name": {"type": "string"},
        "global_share_pct": {"type": ["number", "null"], "description": "Part mondiale de la voie, de 0 à 100, ou null."},
        "description": {"type": "string"},
        "node_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_id", "node_type", "name", "product", "tier", "country_iso2", "place", "lat", "lon",
        "global_share_pct", "buffer_days", "capacity_text", "confidence", "source_ids", "notes"
      ],
      "properties": {
        "node_id": {"type": "string", "description": "Minuscules, chiffres et tirets bas ; unique."},
        "node_type": {
          "type": "string",
          "enum": ["material", "mine", "plant", "recycler", "country", "company", "port", "chokepoint", "waterway", "distributor", "other"]
        },
        "name": {"type": "string"},
        "product": {"type": "string", "description": "Matière produite ou manipulée par le maillon."},
        "tier": {"type": "integer", "enum": [0, 1, 2, 3]},
        "country_iso2": {"type": "string", "description": "Code ISO 3166-1 alpha-2, ou unknown."},
        "place": {"type": "string", "description": "Ville, site, port ou détroit ; unknown sinon."},
        "lat": {"type": ["number", "null"]},
        "lon": {"type": ["number", "null"]},
        "global_share_pct": {"type": ["number", "null"], "description": "Part de la production ou des exportations mondiales, de 0 à 100, ou null."},
        "buffer_days": {"type": ["number", "null"]},
        "capacity_text": {"type": "string", "description": "Capacité publiée avec son unité, ou unknown."},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_id", "to_id", "relation", "transport_mode", "lead_time_days", "share_pct", "confidence", "source_ids"],
      "properties": {
        "from_id": {"type": "string", "description": "Maillon amont."},
        "to_id": {"type": "string", "description": "Maillon aval."},
        "relation": {
          "type": "string",
          "enum": ["feedstock_of", "produces", "ships_via", "yields_coproduct", "supplies"],
          "description": "feedstock_of : produit vers ses utilisateurs ; produces : producteur vers son produit ; ships_via : vers l'étape logistique suivante ou la matière achetée ; yields_coproduct : production principale vers son coproduit ; supplies : lien commercial."
        },
        "transport_mode": {
          "type": "string",
          "enum": ["sea", "river", "rail", "road", "pipeline", "air", "none", "unknown"],
          "description": "none pour un lien sans transport (intrant, production, coproduit)."
        },
        "lead_time_days": {"type": ["number", "null"]},
        "share_pct": {"type": ["number", "null"], "description": "Part du flux aval fournie par l'origine, de 0 à 100, ou null."},
        "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "substitute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "explanation", "source_ids"],
      "properties": {
        "name": {"type": "string"},
        "explanation": {"type": "string"},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "structural_risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk_type", "description", "node_ids", "source_ids"],
      "properties": {
        "risk_type": {
          "type": "string",
          "enum": [
            "geographic_concentration", "single_supplier", "export_control", "logistics_chokepoint",
            "seasonality", "recurring_maintenance", "regulatory", "coproduct_dependency", "other"
          ]
        },
        "description": {"type": "string"},
        "node_ids": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    },
    "upcoming_date": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "what", "node_ids", "source_ids"],
      "properties": {
        "date": {"type": "string", "description": "AAAA-MM-JJ ou AAAA-MM."},
        "what": {"type": "string"},
        "node_ids": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
