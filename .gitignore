# Secrets : jamais dans le dépôt
.env
.env.*
*.pem
*.key
secrets/

# Données locales de l'app
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/
!goulot/data/
backups/
*.log

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
dist/
build/

# Node
node_modules/
frontend/dist/

# macOS
.DS_Store

# Réglages personnels de Claude Code
.claude/settings.local.json

# Fichiers personnels ou obsolètes, gardés sur le Mac uniquement
A_LIRE/0_Etat_du_projet.pdf
_to_delete/

# Aperçu local de Claude Code (chemins de la machine)
.claude/launch.json
# Answers of `goulot dev check-sources` (public pages, development only)
.samples/
# Outputs of a stray `tsc -b` (the build uses `tsc --noEmit`): Vite would serve them instead of the sources
frontend/src/**/*.js
frontend/vite.config.js
frontend/*.tsbuildinfo

# Working notes addressed to Claude Code: personal, never published
docs/RETOURS_*.md
